# ============================================================
# FleetGuard Backend — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret (change this to a long random string in production!)
JWT_SECRET=your_super_secret_jwt_key_here

# ============================================================
# Database — PostgreSQL / Supabase
# Option A: Full connection string (recommended for Supabase)
# Option B: Individual host/user/password variables
# DATABASE_URL takes precedence over individual variables.
# ============================================================
DATABASE_URL=postgresql://your_user:your_password@your_host:5432/your_db_name
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_DATABASE=fleetguard
DB_SSL=true

# ============================================================
# Supabase (optional — used for Supabase JS client)
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# ============================================================
# Firebase Admin SDK Configuration (optional — for Google login)
# Option 1: Individual environment variables
# ============================================================
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-firebase-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Option 2: Full JSON string
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key_id":"...",...}'

# Option 3: Path to JSON service account key file
# FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/serviceAccountKey.json

# ============================================================
# Email Configuration (for nodemailer — optional)
# ============================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here

# ============================================================
# Logging
# ============================================================
LOG_LEVEL=info
