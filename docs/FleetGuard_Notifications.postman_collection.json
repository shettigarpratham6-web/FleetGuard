{
	"info": {
		"_postman_id": "c62bf610-8fd5-416e-a89e-2cd22934ff24",
		"name": "FleetGuard - User Recipient Notification Check",
		"description": "API check suite testing notifications sent specifically from the Admin account to target user (shettigarpratham287@gmail.com).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Admin Login",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const responseData = pm.response.json();",
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test(\"Token is returned\", function () {",
							"    pm.expect(responseData.token).to.be.a('string');",
							"    pm.environment.set(\"token\", responseData.token);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"admin@fleetguard.com\",\n    \"password\": \"admin123\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/auth/login",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"auth",
						"login"
					]
				}
			},
			"response": []
		},
		{
			"name": "2. Register Target User (Shettigar Pratham)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const responseData = pm.response.json();",
							"if (pm.response.code === 201) {",
							"    pm.test(\"Registration successful\", function () {",
							"        pm.expect(responseData.user).to.be.an('object');",
							"        pm.environment.set(\"target_user_id\", responseData.user.id);",
							"        pm.environment.set(\"target_user_token\", responseData.token);",
							"    });",
							"} else {",
							"    pm.test(\"User already exists (proceeding to login fallback)\", function () {",
							"        pm.expect(pm.response.code).to.eql(400);",
							"    });",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"username\": \"shettigarpratham\",\n    \"email\": \"shettigarpratham287@gmail.com\",\n    \"password\": \"password123\",\n    \"full_name\": \"Shettigar Pratham\",\n    \"role\": \"Driver\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/auth/register",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"auth",
						"register"
					]
				}
			},
			"response": []
		},
		{
			"name": "3. Login Target User (Fallback)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const responseData = pm.response.json();",
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test(\"Fetched target user ID and token\", function () {",
							"    pm.expect(responseData.user.id).to.be.a('string');",
							"    pm.environment.set(\"target_user_id\", responseData.user.id);",
							"    pm.environment.set(\"target_user_token\", responseData.token);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"shettigarpratham287@gmail.com\",\n    \"password\": \"password123\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/auth/login",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"auth",
						"login"
					]
				}
			},
			"response": []
		},
		{
			"name": "4. Admin Sends Notification to User",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const responseData = pm.response.json();",
							"pm.test(\"Status code is 201\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"pm.test(\"Notification created successfully\", function () {",
							"    pm.expect(responseData.message).to.eql(\"Notification created successfully\");",
							"    pm.expect(responseData.notification).to.be.an('object');",
							"    pm.environment.set(\"notification_id\", responseData.notification.id);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{token}}",
							"type": "string"
						}
					]
				},
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"user_id\": \"{{target_user_id}}\",\n    \"title\": \"Postman Notification Test\",\n    \"message\": \"This is an administrative update sent to Shettigar Pratham to test the email dispatch logic.\",\n    \"notification_type\": \"Alert\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/notifications",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"notifications"
					]
				}
			},
			"response": []
		},
		{
			"name": "5. Retrieve Notifications as Target User",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const responseData = pm.response.json();",
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test(\"Notification is listed for target user\", function () {",
							"    const found = responseData.notifications.some(n => n.id === pm.environment.get(\"notification_id\"));",
							"    pm.expect(found).to.be.true;",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{target_user_token}}",
							"type": "string"
						}
					]
				},
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/api/notifications",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"notifications"
					]
				}
			},
			"response": []
		},
		{
			"name": "6. Target User Marks Notification as Read",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const responseData = pm.response.json();",
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test(\"Marked as read successfully\", function () {",
							"    pm.expect(responseData.message).to.eql(\"Notification marked as read successfully\");",
							"    pm.expect(responseData.notification.is_read).to.be.true;",
							"});"
						],
						"type": "text/javascript"
					}
